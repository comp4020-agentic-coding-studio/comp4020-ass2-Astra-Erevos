---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import CourseAtmosphere from "../../components/CourseAtmosphere.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <CourseAtmosphere stage="facade" seed="sessions-index" />
  <p>
    Every week from Week 2 to Week 12, a small timetabled group meets to
    practise the lecture just given against an actual human-cat case. Three
    tutors — Idris Fenn, Mina Vale, and Rowan Pike — run parallel groups
    covering identical ground, so which one is yours depends only on your
    enrolment. Two weeks trade the usual task for a showcase of the
    assignment just submitted, and Week 12 closes the semester as a recovery
    and capstone clinic.
  </p>
  <SessionsGrid />
</ContentLayout>

---
/**
 * Layer B of the visual-progression design: a small, fixed pool of
 * decorative marks (paw prints, scratches, a stray thread, tiny field
 * notes) scattered with deterministic pseudo-randomness so the same page
 * always renders the same marks across rebuilds.
 *
 * `stage="facade"` pages (home, People, Policies, collection indexes) get
 * exactly one fixed mark, always the same one — a trace, not a takeover.
 * Numbered stages scale density with how far into the semester a course
 * page's week falls; see `src/lib/stage.ts`.
 */
import "../styles/progression.css";

interface Props {
  stage: 1 | 2 | 3 | 4 | "facade";
  /** Any stable per-page string (a slug is ideal) — seeds the placement. */
  seed: string;
}

const { stage, seed } = Astro.props;

const DENSITY: Record<1 | 2 | 3 | 4, [number, number]> = {
  1: [0, 0],
  2: [1, 2],
  3: [3, 4],
  4: [5, 6],
};

const ICONS = [
  {
    name: "paw",
    svg: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="12" cy="16" rx="6" ry="5"/><ellipse cx="4" cy="9" rx="2.4" ry="3"/><ellipse cx="9.5" cy="5.5" rx="2.4" ry="3"/><ellipse cx="14.5" cy="5.5" rx="2.4" ry="3"/><ellipse cx="20" cy="9" rx="2.4" ry="3"/></svg>`,
  },
  {
    name: "paw-small",
    svg: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="12" cy="17" rx="4.5" ry="3.6"/><ellipse cx="6" cy="11" rx="1.8" ry="2.3"/><ellipse cx="10" cy="8" rx="1.8" ry="2.3"/><ellipse cx="14" cy="8" rx="1.8" ry="2.3"/><ellipse cx="18" cy="11" rx="1.8" ry="2.3"/></svg>`,
  },
  {
    name: "scratch",
    svg: `<svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" aria-hidden="true"><path d="M3 20 L9 3"/><path d="M8 21 L14 4"/><path d="M13 21 L19 5"/></svg>`,
  },
  {
    name: "yarn",
    svg: `<svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4" fill="none" aria-hidden="true"><path d="M3 6 C 9 2, 15 10, 21 6 C 17 12, 21 16, 15 18 C 9 20, 7 14, 3 18"/></svg>`,
  },
] as const;

const NOTES = [
  "checked on the cat. all fine.",
  "still no universal cat.",
  "does not respond to the usual script.",
  "prefers the left side of the box.",
  "revised the model. again.",
  "quiet today. logged anyway.",
  "repair attempt: partially successful.",
  "no notes. observed only.",
] as const;

const POSITIONS = [
  { top: "18%", left: "3%" },
  { top: "62%", right: "4%" },
  { top: "38%", right: "2%" },
  { top: "74%", left: "5%" },
  { top: "12%", right: "6%" },
  { top: "50%", left: "2%" },
] as const;

function mulberry32(seedInt: number) {
  let a = seedInt;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function hashString(value: string): number {
  let hash = 0;
  for (let i = 0; i < value.length; i += 1) {
    hash = (hash << 5) - hash + value.charCodeAt(i);
    hash |= 0;
  }
  return hash;
}

interface Mark {
  kind: "icon" | "note";
  content: string;
  position: Partial<Record<"top" | "left" | "right" | "bottom", string>>;
  rotate: number;
  opacity: number;
  /** Facade mark only: centre horizontally on `position.left` via translateX. */
  center?: boolean;
  small?: boolean;
}

// Fixed to the viewport, bottom-left corner: `.at-nav` is always present at
// the top of every page (sticky, opaque, z-index:100), so any top-anchored
// fixed position risks sitting in or near its band. Anchoring to the
// bottom instead sidesteps the nav and the hero entirely, regardless of
// either one's height.
const FACADE_POSITION = { bottom: "1.5rem", left: "1.5rem" };

function buildMarks(): Mark[] {
  if (stage === "facade") {
    return [
      {
        kind: "icon",
        content: ICONS[0].svg,
        position: FACADE_POSITION,
        rotate: -6,
        opacity: 0.4,
        small: true,
      },
    ];
  }

  const random = mulberry32(hashString(seed));
  const [min, max] = DENSITY[stage];
  const count = min === max ? min : min + Math.floor(random() * (max - min + 1));

  const usedPositions = new Set<number>();
  const marks: Mark[] = [];

  for (let i = 0; i < count; i += 1) {
    const isNote = random() < 0.35;
    const content = isNote
      ? NOTES[Math.floor(random() * NOTES.length)]
      : ICONS[Math.floor(random() * ICONS.length)].svg;

    let positionIndex = Math.floor(random() * POSITIONS.length);
    let attempts = 0;
    while (usedPositions.has(positionIndex) && attempts < POSITIONS.length) {
      positionIndex = (positionIndex + 1) % POSITIONS.length;
      attempts += 1;
    }
    usedPositions.add(positionIndex);

    marks.push({
      kind: isNote ? "note" : "icon",
      content,
      position: POSITIONS[positionIndex],
      rotate: Math.round(random() * 16 - 8),
      opacity: isNote ? 0.55 + random() * 0.15 : 0.4 + random() * 0.2,
    });
  }

  return marks;
}

const marks = buildMarks();
---

{
  marks.length > 0 && (
    <div class="cat-marks" aria-hidden="true">
      {marks.map((mark) => {
        const transform = mark.center
          ? `translateX(-50%) rotate(${mark.rotate}deg)`
          : `rotate(${mark.rotate}deg)`;
        return mark.kind === "icon" ? (
          <div
            class={`cat-mark cat-mark--icon${mark.small ? " cat-mark--small" : ""}`}
            style={{
              ...mark.position,
              "--cat-mark-rotate": `${mark.rotate}deg`,
              transform,
              opacity: mark.opacity,
            }}
            set:html={mark.content}
          />
        ) : (
          <div
            class="cat-mark cat-mark--note"
            style={{
              ...mark.position,
              "--cat-mark-rotate": `${mark.rotate}deg`,
              transform,
              opacity: mark.opacity,
            }}
          >
            {mark.content}
          </div>
        );
      })}
    </div>
  )
}
